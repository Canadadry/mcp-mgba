{
  "name": "mcp-mgba",
  "version": "0.1.0",
  "description": "Headless GBA debugger MCP server, built on libmgba.",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "mcp-mgba": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
